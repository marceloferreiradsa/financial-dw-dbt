# Copie para .env.airflow e preencha os valores.
# Este arquivo E versionado (sem valores reais).
# O .env.airflow NAO e versionado (esta no .gitignore).

# ── Seguranca do Airflow ──────────────────────────────────────────────────────
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=

# ── Credenciais do admin (primeira inicializacao) ─────────────────────────────
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# ── Configuracao de dados ─────────────────────────────────────────────────────
# Caminho do DuckDB DENTRO do container (mapeado pelo volume duckdb-data)
DUCKDB_PATH=/opt/airflow/data/financial_dw.duckdb

# Caminho do projeto dbt DENTRO do container (mapeado pelo bind mount)
DBT_PROJECT_DIR=/opt/airflow/dbt_project

# Parametros de ingestao
BACEN_START_DATE=2020-01-01
TICKERS=PETR4,MGLU3,VALE3,ITUB4
