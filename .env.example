# Copie para .env e preencha — .env está no .gitignore e NUNCA deve ser commitado

# Caminho para o banco DuckDB local (relativo à raiz do projeto)
DUCKDB_PATH=./data/financial_dw.duckdb

# Intervalo de datas para ingestão histórica
BACEN_START_DATE=2020-01-01
BACEN_END_DATE=2025-12-31

# Tickers B3 (sufixo .SA obrigatório para Yahoo Finance)
TICKERS=PETR4,MGLU3,VALE3,ITUB4


# Token para a API da Brapi
BRAPI_API_KEY=seu_token_brapi  # Obtenha em brapi.dev/dashboard
